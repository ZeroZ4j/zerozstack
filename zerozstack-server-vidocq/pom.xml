<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zeroz4j</groupId>
        <artifactId>zerozstack-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>zerozstack-server-vidocq</artifactId>
    <name>zeroz4j Server Vidocq Runtime (experimental)</name>
    <description>Runs a ZeroZ Stack server on the Vidocq runtime instead of Helidon. Experimental;
        needs Java 25. Built only under the vidocq profile.</description>

    <properties>
        <!-- Vidocq's own version, not ours. -->
        <vidocq.version>0.3.0</vidocq.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <maven.compiler.release>25</maven.compiler.release>
        <!-- JaCoCo 0.8.12 cannot read Java 25 class files. -->
        <jacoco.skip>true</jacoco.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.zeroz4j</groupId>
            <artifactId>zerozstack-server-core</artifactId>
        </dependency>
        <!-- Chappe: Vidocq's HTTP and WebSocket server. -->
        <dependency>
            <groupId>io.vidocq.chappe</groupId>
            <artifactId>chappe-core</artifactId>
            <version>${vidocq.version}</version>
        </dependency>
        <!-- Vauban: Vidocq's CDI Lite container. -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
            <version>${vidocq.version}</version>
        </dependency>
        <!-- MicroProfile Config for Vauban: beans that inject @ConfigProperty need it. -->
        <dependency>
            <groupId>io.vidocq.ravel</groupId>
            <artifactId>ravel-cdi-vauban</artifactId>
            <version>${vidocq.version}</version>
        </dependency>
        <!-- The Jakarta WebSocket API, interfaces only: the types the engine is written against.
             No implementation; this binding supplies the Session itself. -->
        <dependency>
            <groupId>jakarta.websocket</groupId>
            <artifactId>jakarta.websocket-api</artifactId>
            <version>2.1.1</version>
        </dependency>
        <dependency>
            <groupId>jakarta.websocket</groupId>
            <artifactId>jakarta.websocket-client-api</artifactId>
            <version>2.1.1</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>25</release>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
