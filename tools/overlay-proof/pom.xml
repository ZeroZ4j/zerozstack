<!--
  Deliberately NOT part of the reactor. This is a test harness: it compiles the real component
  library to JavaScript so a real browser can be driven against it, and nobody building or
  releasing ZeroZ Stack should pay for that. run.ps1 packages the library first and drops the
  jars in lib/, which is why the two dependencies below are system-scoped and version-free.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.zeroz4j.tools</groupId>
    <artifactId>overlay-proof</artifactId>
    <version>1</version>
    <packaging>jar</packaging>
    <name>Overlay proof harness</name>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <teavm.version>0.15.0</teavm.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.teavm</groupId>
            <artifactId>teavm-classlib</artifactId>
            <version>${teavm.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.teavm</groupId>
            <artifactId>teavm-jso</artifactId>
            <version>${teavm.version}</version>
        </dependency>
        <dependency>
            <groupId>org.teavm</groupId>
            <artifactId>teavm-jso-apis</artifactId>
            <version>${teavm.version}</version>
        </dependency>
        <dependency>
            <groupId>com.zeroz4j</groupId>
            <artifactId>zerozstack-ui-components</artifactId>
            <version>local</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/ui-components.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.zeroz4j</groupId>
            <artifactId>zerozstack-shared-api</artifactId>
            <version>local</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/shared-api.jar</systemPath>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.teavm</groupId>
                <artifactId>teavm-maven-plugin</artifactId>
                <version>${teavm.version}</version>
                <executions>
                    <execution>
                        <id>compile-js</id>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <targetDirectory>${project.basedir}/web/js</targetDirectory>
                            <mainClass>com.zeroz4j.ui.proof.OverlayProofPage</mainClass>
                            <targetType>JAVASCRIPT</targetType>
                            <minifying>false</minifying>
                            <optimizationLevel>SIMPLE</optimizationLevel>
                            <debugInformationGenerated>false</debugInformationGenerated>
                            <sourceMapsGenerated>false</sourceMapsGenerated>
                            <strict>false</strict>
                            <compileScopes>
                                <scope>compile</scope>
                                <scope>provided</scope>
                                <scope>system</scope>
                                <scope>runtime</scope>
                            </compileScopes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
