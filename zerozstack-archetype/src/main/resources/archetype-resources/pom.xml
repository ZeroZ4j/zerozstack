<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>${groupId}</groupId>
  <artifactId>${artifactId}</artifactId>
  <version>${version}</version>
  <packaging>pom</packaging>
  
  <properties>
    <zeroz4j.version>${zeroz4jVersion}</zeroz4j.version>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <modules>
    <module>${rootArtifactId}-shared</module>
    <module>${rootArtifactId}-client</module>
    <module>${rootArtifactId}-server</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.zeroz4j</groupId>
        <artifactId>zerozstack-bom</artifactId>
        <version>${zeroz4j.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>${groupId}</groupId>
        <artifactId>${rootArtifactId}-shared</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${groupId}</groupId>
        <artifactId>${rootArtifactId}-client</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <!-- The processor path must be explicit. JDK 23 disabled implicit annotation processing
               (JEP 470), so a processor found only on the classpath is silently ignored: no
               *_Serializer, no *_Stub, no BinaryPackableRegistrar, no error and no warning. The
               application then compiles, starts, serves pages, and fails on the first shared-signal
               broadcast. Declared here in the root pom so shared, client and server all inherit it —
               the shared module is where @DataModel types live. -->
          <annotationProcessorPaths>
            <path>
              <groupId>com.zeroz4j</groupId>
              <artifactId>zerozstack-apt</artifactId>
              <version>${zeroz4j.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>