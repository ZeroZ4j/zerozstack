<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>${groupId}</groupId>
    <artifactId>${rootArtifactId}</artifactId>
    <version>${version}</version>
  </parent>
  <artifactId>${rootArtifactId}-server</artifactId>

  <!-- The container this server runs on. Application code never names it: ServerApp calls
       Zeroz4jServer.start, and that uses whichever binding module is on the classpath. These two
       properties are this project's default; the helidon and vidocq profiles at the bottom of
       this file set them the other way, so `mvn install -Pvidocq` or `-Phelidon` switches with no
       source edit. Vidocq is experimental and needs Java 25, here and to run. -->
  <properties>
    <zeroz4j.container>${container}</zeroz4j.container>
    <zeroz4j.server.java>#if( $container == 'vidocq' )25#{else}21#{end}</zeroz4j.server.java>
    <maven.compiler.source>${zeroz4j.server.java}</maven.compiler.source>
    <maven.compiler.target>${zeroz4j.server.java}</maven.compiler.target>
  </properties>

  <dependencies>
    <dependency>
      <groupId>${groupId}</groupId>
      <artifactId>${rootArtifactId}-shared</artifactId>
    </dependency>
    <dependency>
      <groupId>${groupId}</groupId>
      <artifactId>${rootArtifactId}-client</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- zerozstack-server-helidon or zerozstack-server-vidocq; see the properties above. -->
    <dependency>
      <groupId>com.zeroz4j</groupId>
      <artifactId>zerozstack-server-${zeroz4j.container}</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zeroz4j</groupId>
      <artifactId>zerozstack-apt</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- Must be listed explicitly: declaring <resources> replaces the default src/main/resources,
           which would silently drop logging.properties and break ServerApp on startup. -->
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- The compiled client, served by the server from the classpath at /js/classes.js -->
      <resource>
        <directory>${project.basedir}/../${rootArtifactId}-client/target/js</directory>
        <targetPath>META-INF/resources/js</targetPath>
      </resource>
      <!-- index.html and any static assets, served at / -->
      <resource>
        <directory>${project.basedir}/../${rootArtifactId}-client/src/main/webapp</directory>
        <targetPath>META-INF/resources</targetPath>
      </resource>
    </resources>

    <plugins>
      <!-- Empties target/libs before it is refilled. copy-dependencies only adds, so after a
           dependency version changes without a `mvn clean` the directory holds both the old and
           the new jar. Every framework class is then on the classpath twice and the app dies at
           startup with "WELD-001409: Ambiguous dependencies" — a message that says nothing about
           the actual cause. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <executions>
          <execution>
            <id>purge-libs</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>clean</goal>
            </goals>
            <configuration>
              <excludeDefaultDirectories>true</excludeDefaultDirectories>
              <!-- A running server holds these jars open on Windows; a stale libs dir is a far
                   smaller problem than a build that cannot complete. -->
              <failOnError>false</failOnError>
              <filesets>
                <fileset>
                  <directory>${project.build.directory}/libs</directory>
                </fileset>
              </filesets>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Copies every dependency into target/libs so the app can be launched with
           java -cp "target/classes;target/libs/*" ${package}.server.ServerApp
           (use ':' instead of ';' on Linux and macOS). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-libs</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/libs</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
          <execution>
            <id>copy-libs-provided</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/libs</outputDirectory>
              <includeScope>provided</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- mvn install -Phelidon / mvn install -Pvidocq: build this server for the other container.
         Each only sets the two properties at the top of this file. Run `mvn clean install` when
         switching, so target/libs holds one container's jars and not both. -->
    <profile>
      <id>helidon</id>
      <properties>
        <zeroz4j.container>helidon</zeroz4j.container>
        <zeroz4j.server.java>21</zeroz4j.server.java>
      </properties>
    </profile>
    <profile>
      <id>vidocq</id>
      <properties>
        <zeroz4j.container>vidocq</zeroz4j.container>
        <zeroz4j.server.java>25</zeroz4j.server.java>
      </properties>
    </profile>

    <!--
        mvn verify -Ppackage

        Produces a self-contained, double-clickable application at
        target/dist/${rootArtifactId}/ — launcher executable, every jar unmodified in lib/, and a
        bundled Java runtime. Ships as one folder; no Java installation needed on the target
        machine. Uses the JDK's own jpackage, so there is nothing to install for the build either.

        Deliberately NOT a shaded jar: Weld treats each jar as a bean archive with its own
        beans.xml and discovery mode, and melting them into one jar collapses that structure —
        beans vanish or appear twice, far from the cause. jpackage keeps every jar intact.
    -->
    <profile>
      <id>package</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>assemble-jpackage-input</id>
                <phase>verify</phase>
                <goals><goal>run</goal></goals>
                <configuration>
                  <target>
                    <!-- jpackage refuses to overwrite an existing image. Retried, because on
                         Windows the antivirus holds a freshly created .exe open for a moment,
                         and a still-running packaged app holds it longer - the retry rides out
                         the first and gives a clear repeated failure for the second. -->
                    <retry retrycount="5" retrydelay="2000">
                      <delete dir="${project.build.directory}/dist"/>
                    </retry>
                    <mkdir dir="${project.build.directory}/package/lib"/>
                    <copy todir="${project.build.directory}/package/lib">
                      <fileset dir="${project.build.directory}/libs"/>
                    </copy>
                    <copy file="${project.build.directory}/${project.build.finalName}.jar"
                          todir="${project.build.directory}/package/lib"/>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>jpackage</id>
                <phase>verify</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>${java.home}/bin/jpackage</executable>
                  <commandlineArgs>--type app-image --name ${rootArtifactId} --input "${project.build.directory}/package/lib" --main-jar ${project.build.finalName}.jar --main-class ${package}.server.ServerApp --dest "${project.build.directory}/dist" ${jpackage.platform.args}</commandlineArgs>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- A server needs its console: without this the Windows launcher is a windowed app and the
         log output goes nowhere visible. Harmless elsewhere; the option only exists on Windows. -->
    <profile>
      <id>jpackage-windows-console</id>
      <activation>
        <os><family>windows</family></os>
      </activation>
      <properties>
        <jpackage.platform.args>--win-console</jpackage.platform.args>
      </properties>
    </profile>
    <profile>
      <id>jpackage-default-args</id>
      <activation>
        <os><family>!windows</family></os>
      </activation>
      <properties>
        <jpackage.platform.args></jpackage.platform.args>
      </properties>
    </profile>
  </profiles>
</project>