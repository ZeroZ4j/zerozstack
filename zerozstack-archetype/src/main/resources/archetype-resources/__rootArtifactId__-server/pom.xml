<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>${groupId}</groupId>
    <artifactId>${rootArtifactId}</artifactId>
    <version>${version}</version>
  </parent>
  <artifactId>${rootArtifactId}-server</artifactId>
  
  <dependencies>
    <dependency>
      <groupId>${groupId}</groupId>
      <artifactId>${rootArtifactId}-shared</artifactId>
    </dependency>
    <dependency>
      <groupId>${groupId}</groupId>
      <artifactId>${rootArtifactId}-client</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.zeroz4j</groupId>
      <artifactId>zerozstack-server-helidon</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zeroz4j</groupId>
      <artifactId>zerozstack-apt</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- Must be listed explicitly: declaring <resources> replaces the default src/main/resources,
           which would silently drop logging.properties and break ServerApp on startup. -->
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- The compiled client, served by Helidon from the classpath at /js/classes.js -->
      <resource>
        <directory>${project.basedir}/../${rootArtifactId}-client/target/js</directory>
        <targetPath>META-INF/resources/js</targetPath>
      </resource>
      <!-- index.html and any static assets, served at / -->
      <resource>
        <directory>${project.basedir}/../${rootArtifactId}-client/src/main/webapp</directory>
        <targetPath>META-INF/resources</targetPath>
      </resource>
    </resources>

    <plugins>
      <!-- Empties target/libs before it is refilled. copy-dependencies only adds, so after a
           dependency version changes without a `mvn clean` the directory holds both the old and
           the new jar. Every framework class is then on the classpath twice and the app dies at
           startup with "WELD-001409: Ambiguous dependencies" — a message that says nothing about
           the actual cause. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <executions>
          <execution>
            <id>purge-libs</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>clean</goal>
            </goals>
            <configuration>
              <excludeDefaultDirectories>true</excludeDefaultDirectories>
              <!-- A running server holds these jars open on Windows; a stale libs dir is a far
                   smaller problem than a build that cannot complete. -->
              <failOnError>false</failOnError>
              <filesets>
                <fileset>
                  <directory>${project.build.directory}/libs</directory>
                </fileset>
              </filesets>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Copies every dependency into target/libs so the app can be launched with
           java -cp "target/classes;target/libs/*" ${package}.server.ServerApp
           (use ':' instead of ';' on Linux and macOS). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-libs</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/libs</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
          <execution>
            <id>copy-libs-provided</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/libs</outputDirectory>
              <includeScope>provided</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>