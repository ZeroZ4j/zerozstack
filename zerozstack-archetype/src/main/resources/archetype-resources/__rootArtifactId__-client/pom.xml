<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>${groupId}</groupId>
    <artifactId>${rootArtifactId}</artifactId>
    <version>${version}</version>
  </parent>
  <artifactId>${rootArtifactId}-client</artifactId>

  <properties>
    <!--
        How hard TeaVM works when it turns this module's Java into the browser bundle.

        These are the DEVELOPMENT values. What they buy is a bundle with readable names, so a
        stack trace in the browser console names your methods instead of single letters. What they
        cost is size: the bundle is roughly four times larger than the one the `production` profile
        at the bottom of this file produces.

        They do NOT make the build meaningfully faster - measured on a freshly generated project,
        SIMPLE and unminified takes about as long as ADVANCED and minified, because almost all of
        the time goes on translating the framework runtime rather than on optimizing it. The speed
        of an ordinary check comes from the <phase> below, not from these. The difference between
        the two settings does grow with the amount of client code.
    -->
    <teavm.optimizationLevel>SIMPLE</teavm.optimizationLevel>
    <teavm.minifying>false</teavm.minifying>

    <!-- The daisyUI themes `-Pproduction` puts in the finished stylesheet. The theme marked default
         is used when the visitor's system has no preference, the one marked prefersdark when it is
         dark. If you call Theme.configure(...) with other theme names, list the same names here. -->
    <zeroz4j.css.themes>light --default, dark --prefersdark</zeroz4j.css.themes>
  </properties>

  <dependencies>
    <!-- TeaVM's JDK emulation. Without it the TeaVM compile fails with
         "Class java.util.concurrent.ConcurrentHashMap was not found". Version comes from zerozstack-bom. -->
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>${groupId}</groupId>
      <artifactId>${rootArtifactId}-shared</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zeroz4j</groupId>
      <artifactId>zerozstack-client</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zeroz4j</groupId>
      <artifactId>zerozstack-ui-components</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zeroz4j</groupId>
      <artifactId>zerozstack-apt</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-maven-plugin</artifactId>
        <version>0.15.0</version>
        <executions>
          <execution>
            <id>browser-bundle</id>
            <goals>
              <goal>compile</goal>
            </goals>
            <!--
                prepare-package, NOT the plugin's own default of process-classes.

                Translating this module to JavaScript is by far the slowest step in the build, and
                process-classes runs during `mvn test-compile` - so every check for a typo paid for
                a full browser compile. From prepare-package it runs when something is actually
                being built to run: `mvn package`, `mvn install`, `mvn verify`.

                What this costs you: `mvn compile` and `mvn test-compile` no longer write
                target/js at all. A command that stops before `package` therefore checks the Java
                and nothing else, and a mistake only the browser compiler can see - it rejects some
                Java that javac accepts - will not be reported until the next full build. If you
                have a pipeline that runs `mvn test` and stops, give it `mvn verify` instead, or it
                is not compiling your user interface for the browser at all.
            -->
            <phase>prepare-package</phase>
            <configuration>
              <mainClass>${package}.client.ClientApp</mainClass>
              <!-- No <mainPageIncluded> here: teavm-maven-plugin 0.15.0 does not recognise it and
                   silently ignores it, which reads as if the page bootstrap were being handled.
                   The backend emits a UMD module that exports main rather than calling it, so
                   index.html invokes it explicitly. -->
              <!-- TeaVM's JavaScript backend. The WasmGC backend is not currently supported by
                   zerozstack-client; see docs/reference/limitations.md#compilation-target. -->
              <targetType>JAVASCRIPT</targetType>
              <!-- Set from the properties at the top of this file, so that `-Pproduction` can
                   raise both of them together. Written out rather than left to the plugin's
                   defaults because the default for minifying is TRUE, and a setting that
                   important should not be invisible. -->
              <optimizationLevel>${teavm.optimizationLevel}</optimizationLevel>
              <minifying>${teavm.minifying}</minifying>
              <targetDirectory>${project.build.directory}/js</targetDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
        mvn install -Pproduction

        The shape you ship: whole-program optimization and minified names, and about a quarter
        the download. On a small project it costs little more build time than an ordinary one; the
        gap grows as the client does.

        BUILD AND RUN THIS BEFORE YOU RELEASE ANYTHING. Minification renames things, and renaming
        can break code that a readable build runs perfectly - it has happened in this framework
        before, and it reached two releases because nobody ran the minified shape until users did.
        An ordinary build is for developing. This one is what your users get.
    -->
    <profile>
      <id>production</id>
      <properties>
        <teavm.optimizationLevel>ADVANCED</teavm.optimizationLevel>
        <teavm.minifying>true</teavm.minifying>
      </properties>
      <build>
        <plugins>
          <!--
              One finished, minified stylesheet instead of the two CDN tags in index.html.

              What happens, in order:
                1. The class list and the build script are unpacked from zerozstack-ui-components.
                2. The script downloads the pinned Tailwind standalone executable for this machine
                   (Windows, Linux or macOS; x64 or arm64) and daisyUI's bundle ONCE into
                   ~/.zeroz4j/cache, checks both against SHA-256 values pinned in the script, and
                   fails the build if either differs. Later builds use the cached copies, so this
                   is the only step that needs the network.
                3. It runs Tailwind over the component library's class list, your Java sources and
                   index.html, and writes target/webapp-production/ : a copy of src/main/webapp
                   whose index.html links css/app-<hash>.css instead of the CDN tags.
              The server module serves that folder in place of src/main/webapp when -Pproduction is on.
              An ordinary build is unchanged: CDN tags, nothing downloaded.
          -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.6.1</version>
            <executions>
              <execution>
                <id>unpack-css-tooling</id>
                <phase>process-resources</phase>
                <goals>
                  <goal>unpack-dependencies</goal>
                </goals>
                <configuration>
                  <includeArtifactIds>zerozstack-ui-components</includeArtifactIds>
                  <includes>META-INF/zeroz4j/css/**</includes>
                  <outputDirectory>${project.build.directory}/zeroz4j-css</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>production-stylesheet</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${java.home}/bin/java</executable>
                  <arguments>
                    <argument>${project.build.directory}/zeroz4j-css/META-INF/zeroz4j/css/ProductionCss.java</argument>
                    <argument>${project.build.directory}/zeroz4j-css</argument>
                    <argument>${project.basedir}</argument>
                    <argument>${zeroz4j.css.themes}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
