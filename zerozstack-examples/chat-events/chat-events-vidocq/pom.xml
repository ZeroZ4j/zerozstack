<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zeroz4j</groupId>
        <artifactId>chat-events</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>chat-events-vidocq</artifactId>
    <name>zeroz4j Example chat-events on Vidocq</name>
    <description>Runs the unchanged chat-events server on the Vidocq runtime. This module has no code: it
        collects the example's jars without Helidon, plus zerozstack-server-vidocq, into target/libs.
        Built only under the vidocq profile (Java 25). See docs/guides/vidocq-server.md.</description>

    <dependencies>
        <dependency>
            <groupId>com.zeroz4j</groupId>
            <artifactId>chat-events-server</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <exclusion><groupId>com.zeroz4j</groupId><artifactId>zerozstack-server-helidon</artifactId></exclusion>
                <exclusion><groupId>com.zeroz4j</groupId><artifactId>zerozstack-server-jaxrs</artifactId></exclusion>
                <exclusion><groupId>io.helidon.microprofile.bundles</groupId><artifactId>helidon-microprofile</artifactId></exclusion>
                <exclusion><groupId>io.helidon.microprofile.websocket</groupId><artifactId>helidon-microprofile-websocket</artifactId></exclusion>
                <exclusion><groupId>io.helidon.logging</groupId><artifactId>helidon-logging-jul</artifactId></exclusion>
                <exclusion><groupId>io.helidon.logging</groupId><artifactId>helidon-logging-slf4j</artifactId></exclusion>
                <exclusion><groupId>io.smallrye</groupId><artifactId>jandex</artifactId></exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.zeroz4j</groupId>
            <artifactId>zerozstack-server-vidocq</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-libs</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/libs</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
