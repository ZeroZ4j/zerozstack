<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zeroz4j</groupId>
        <artifactId>zerozstack-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>zerozstack-examples</artifactId>

    <packaging>pom</packaging>

    <properties>
        <!-- Examples are demonstrations, not libraries. They are built and tested with the
             reactor but must never reach a repository, and there is no point signing or
             producing source and javadoc jars for artifacts nobody consumes. These properties
             are inherited by every example module. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <skipPublishing>true</skipPublishing>
        <gpg.skip>true</gpg.skip>
        <maven.source.skip>true</maven.source.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
    </properties>

    <build>
        <plugins>
            <!-- Empties target/libs before copy-dependencies refills it. That goal only adds, so
                 after a version bump without a `mvn clean` the directory holds both the old and the
                 new framework jars, every class is on the classpath twice, and the example dies at
                 startup with "WELD-001409: Ambiguous dependencies" — which says nothing about the
                 real cause. Harmless in modules that have no target/libs. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <id>purge-libs</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <!-- A running server holds these jars open on Windows; a stale libs dir is a far
                                 smaller problem than a build that cannot complete. -->
                            <failOnError>false</failOnError>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.directory}/libs</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <modules>
        <module>components-showcase</module>
        <module>chat-events</module>
        <module>todo-signals</module>
        <module>chat-livesync</module>
        <module>form-signup</module>
        <module>job-monitor</module>
        <module>inventory-crud</module>
        <module>routing-tour</module>
        <module>scoped-signals</module>
        <module>oidc-login</module>
        <module>pwa-install</module>
    </modules>

</project>
