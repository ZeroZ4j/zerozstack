<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zeroz4j</groupId>
        <artifactId>zerozstack-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>zerozstack-ui-components</artifactId>
    <name>zeroz4j UI Components</name>
    <description>Vaadin-style Java Component Library using DaisyUI and TeaVM Flavour</description>

    <dependencies>
        <dependency>
            <groupId>com.zeroz4j</groupId>
            <artifactId>zerozstack-shared-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.teavm</groupId>
            <artifactId>teavm-jso</artifactId>
        </dependency>
        <dependency>
            <groupId>org.teavm</groupId>
            <artifactId>teavm-jso-apis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.frequal.flavour</groupId>
            <artifactId>teavm-flavour-widgets</artifactId>
            <version>0.3.2</version>
        </dependency>
        <dependency>
            <groupId>org.teavm</groupId>
            <artifactId>teavm-classlib</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
          Compiles the field proof page (src/test/java/com/zeroz4j/ui/domproof) to JavaScript, so
          FieldDomProofTest can open it in headless Chrome and ask the browser what a person would
          see. There is no server-side DOM here, so that is the only place the question can be
          answered - and not answering it is how 0.7.0 shipped a form that turned red and said
          nothing. Adds roughly ten seconds to this module's build; -DskipDomProof leaves it out,
          and the test then reports itself as skipped rather than failing.
        -->
        <profile>
            <id>dom-proof</id>
            <activation>
                <property>
                    <name>!skipDomProof</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <!--
                                  TeaVM compiles from one directory of class files, and the page
                                  being proved needs both the library and the harness, so the two
                                  are staged together here rather than shipping the harness in the
                                  published jar.
                                -->
                                <id>stage-field-proof-classes</id>
                                <phase>process-test-classes</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/domproof-classes</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.outputDirectory}</directory>
                                        </resource>
                                        <resource>
                                            <directory>${project.build.testOutputDirectory}</directory>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.teavm</groupId>
                        <artifactId>teavm-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>compile-field-proof</id>
                                <phase>process-test-classes</phase>
                                <goals>
                                    <goal>compile</goal>
                                </goals>
                                <configuration>
                                    <classFiles>${project.build.directory}/domproof-classes</classFiles>
                                    <targetDirectory>${project.build.directory}/domproof</targetDirectory>
                                    <mainClass>com.zeroz4j.ui.domproof.FieldDomProof</mainClass>
                                    <targetType>JAVASCRIPT</targetType>
                                    <minifying>false</minifying>
                                    <optimizationLevel>SIMPLE</optimizationLevel>
                                    <debugInformationGenerated>false</debugInformationGenerated>
                                    <sourceMapsGenerated>false</sourceMapsGenerated>
                                    <compileScopes>
                                        <scope>compile</scope>
                                        <scope>provided</scope>
                                        <scope>runtime</scope>
                                    </compileScopes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
